# Copy to .env and fill in before running with MCP_TRANSPORT=http.
# Never commit the real .env — it's already in .gitignore.

# Enables the remote HTTP server instead of stdio. Leave unset for local use.
MCP_TRANSPORT=http

# Required in http mode. Generate with: openssl rand -hex 32
# This is the only thing standing between a network client and your
# real Messages history, so treat it like a password.
MCP_AUTH_TOKEN=

# Required in http mode: the hostname your tunnel actually serves this on,
# for example messages.your-tunnel.example. The server checks every
# request's Host header against this and rejects a mismatch with 421,
# that's DNS-rebinding protection, done in front of the transport rather
# than through the MCP SDK's now-deprecated built-in flag for it.
MCP_PUBLIC_HOST=

# Optional, defaults shown.
MCP_PORT=8443
MCP_HOST=127.0.0.1
